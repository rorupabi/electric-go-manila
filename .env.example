# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Connect -> Direct -> Session pooler (port 5432). Replace [YOUR-PASSWORD], no brackets.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Supabase (Project Settings -> API Keys -> Legacy API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage buckets (create in Supabase -> Storage) ---
SUPABASE_BUCKET_PRODUCTS=products
SUPABASE_BUCKET_RECEIPTS=receipts

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# This email becomes the shop admin. `npm run seed` creates it with ADMIN_PASSWORD.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
